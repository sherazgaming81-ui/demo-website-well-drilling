# Site assistant brain — the Dahl Inference gateway (OpenAI-compatible, free tier).
# GET <base>/models lists what the account can call; the defaults below are those slugs.
DAHL_API_KEY=
DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731,MiniMaxAI/MiniMax-M2.7,zai-org/GLM-5.3-Flash
AI_PROVIDER_CHAIN=dahl

# Optional: forward every estimate request (form or chat) to an inbox, CRM or Slack.
LEAD_WEBHOOK_URL=

# Overrides the canonical host used by metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=
